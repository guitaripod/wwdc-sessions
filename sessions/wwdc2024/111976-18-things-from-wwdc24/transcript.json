{"$schema": "https://raw.githubusercontent.com/guitaripod/wwdc-sessions/master/schema/transcript.schema.json", "id": "wwdc2024-111976", "language": "eng", "source": "https://developer.apple.com/videos/play/wwdc2024/111976", "wordCount": 350, "segments": [{"start": 0.0, "text": "Voiceover: Siri,"}, {"start": 1.0, "text": "play that one song Diego sent me."}, {"start": 2.0, "text": "♪ \"So Happy\" (feat. Laura Mvula & Francis and the Lights)"}, {"start": 4.0, "text": "by Kassa Overall ♪"}, {"start": 6.0, "text": "OK... Oh! How'd it do that?"}, {"start": 9.0, "text": "With Apple Intelligence."}, {"start": 11.0, "text": "It's AI that gets you, on your Apple products --"}, {"start": 15.0, "text": "iPhone, iPad, Mac -- with built-in privacy."}, {"start": 19.0, "text": "And you can make your own emoji."}, {"start": 21.0, "text": "Yeah."}, {"start": 22.0, "text": "Make."}, {"start": 23.0, "text": "Your."}, {"start": 24.0, "text": "Own."}, {"start": 25.0, "text": "Emoji."}, {"start": 26.0, "text": "Make your new profile pic with Image Playground."}, {"start": 30.0, "text": "Pull up a photo by describing it."}, {"start": 33.0, "text": "Or clean up an otherwise very cute pic."}, {"start": 37.0, "text": "You can make a movie!"}, {"start": 38.0, "text": "Your life plus a description plus your camera roll"}, {"start": 41.0, "text": "equals sweet memories."}, {"start": 42.0, "text": "Wait."}, {"start": 43.0, "text": "Siri? When's Mom's flight landing?"}, {"start": 45.0, "text": "Oh. Where are we eating after?"}, {"start": 48.0, "text": "Ah. How do I share a password?"}, {"start": 51.0, "text": "What if I forget all this stuff?"}, {"start": 53.0, "text": "Siri: Just ask. Voiceover: Oh..."}, {"start": 56.0, "text": "Apple Intelligence can TL;DR your long messages"}, {"start": 59.0, "text": "and highlights the important ones."}, {"start": 62.0, "text": "It can just find stuff deep in your phone"}, {"start": 64.0, "text": "like your driver's license number"}, {"start": 66.0, "text": "or that front-row concert ticket."}, {"start": 70.0, "text": "Coming to iPad..."}, {"start": 74.0, "text": "Calculator."}, {"start": 77.0, "text": "And you can just handwrite a math problem."}, {"start": 80.0, "text": "Math Note solves it for you."}, {"start": 82.0, "text": "Or write something not even you can read,"}, {"start": 84.0, "text": "and iPad will clean it right up."}, {"start": 87.0, "text": "Say what you really mean in Messages,"}, {"start": 89.0, "text": "with more expression, more personality, more you,"}, {"start": 93.0, "text": "now or later,"}, {"start": 95.0, "text": "from just about anywhere,"}, {"start": 96.0, "text": "even without a phone signal..."}, {"start": 98.0, "text": "...because of satellites."}, {"start": 101.0, "text": "Ugh! I forgot my phone."}, {"start": 103.0, "text": "Oh! I can just pull it up on Mac and use it!"}, {"start": 106.0, "text": "Digital voice: La manzana."}, {"start": 108.0, "text": "Voiceover: Ooh! I'm going to get another coffee."}, {"start": 111.0, "text": "Hey, bud..."}, {"start": 112.0, "text": "Focus, focus."}, {"start": 114.0, "text": "Customize your iPhone's Home Screen"}, {"start": 116.0, "text": "and these buttons."}, {"start": 118.0, "text": "Hide or lock the apps you want to, um,"}, {"start": 121.0, "text": "keep to yourself."}, {"start": 122.0, "text": "Siri: Call from Dump Him."}, {"start": 124.0, "text": "Answer it?"}, {"start": 125.0, "text": "Voiceover: Mm-mm."}, {"start": 126.0, "text": "Just shake or nod to reply to Siri with AirPods."}, {"start": 130.0, "text": "See how much effort you've put in with Apple Watch."}, {"start": 132.0, "text": "Whew! Time to chill."}, {"start": 135.0, "text": "Take up some space."}, {"start": 137.0, "text": "Whoa, that's big!"}, {"start": 139.0, "text": "Revisit these cuties in Spatial."}, {"start": 142.0, "text": "And immerse yourself with these guys on Vision Pro."}, {"start": 146.0, "text": "OK, there's more than 18 things."}, {"start": 149.0, "text": "Way more. But, whatever! You deserve it."}, {"start": 153.0, "text": "See you this fall."}]}
