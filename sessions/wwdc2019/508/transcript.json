{"id": "wwdc2019-508", "language": "eng", "source": "https://developer.apple.com/videos/play/wwdc2019/508", "wordCount": 174, "segments": [{"start": 7.0, "text": "Hello, and welcome to our"}, {"start": 9.0, "text": "session about Modernizing Your"}, {"start": 11.0, "text": "Audio App."}, {"start": 12.0, "text": "My name is Peter Vasil, and I'm"}, {"start": 14.0, "text": "a software engineer in the Core"}, {"start": 15.0, "text": "Audio Team."}, {"start": 16.0, "text": "Let's start with audio units."}, {"start": 21.0, "text": "Support for"}, {"start": 22.0, "text": "Carbon-Component-Based Audio"}, {"start": 23.0, "text": "Units will be removed in a"}, {"start": 25.0, "text": "future macOS release."}, {"start": 28.0, "text": "We encourage hosts to use the"}, {"start": 29.0, "text": "AudioComponent API for audio"}, {"start": 31.0, "text": "unit discovery."}, {"start": 35.0, "text": "With the next OS release,"}, {"start": 37.0, "text": "AudioHardwarePlugIn-based"}, {"start": 38.0, "text": "plugins are disabled by default."}, {"start": 42.0, "text": "We recommend using the"}, {"start": 43.0, "text": "AudioServerPlugin API instead."}, {"start": 46.0, "text": "For now, disabled plugins can be"}, {"start": 48.0, "text": "re-enabled in the Audio MIDI"}, {"start": 50.0, "text": "Setup utility, but support will"}, {"start": 53.0, "text": "be removed completely in a"}, {"start": 54.0, "text": "future macOS release."}, {"start": 56.0, "text": "With the next OS release, we"}, {"start": 60.0, "text": "will introduce some"}, {"start": 61.0, "text": "deprecations."}, {"start": 62.0, "text": "AUGraph, Inter-App Audio, and"}, {"start": 65.0, "text": "OpenAL will be deprecated."}, {"start": 67.0, "text": "We encourage developers to"}, {"start": 69.0, "text": "switch over to AVAudioEngine, as"}, {"start": 71.0, "text": "replacement for AUGraph and"}, {"start": 73.0, "text": "OpenAL."}, {"start": 75.0, "text": "For Inter-App Audio, please use"}, {"start": 77.0, "text": "Audio Unit Extensions instead."}, {"start": 80.0, "text": "The 3D Mixer parameters have"}, {"start": 83.0, "text": "been unified across all"}, {"start": 84.0, "text": "platforms."}, {"start": 85.0, "text": "For details, please refer to the"}, {"start": 87.0, "text": "AudioUnitParameters header file"}, {"start": 90.0, "text": "for a list of new and deprecated"}, {"start": 92.0, "text": "parameters."}, {"start": 93.0, "text": "For more information, please"}, {"start": 95.0, "text": "visit the developer website."}]}