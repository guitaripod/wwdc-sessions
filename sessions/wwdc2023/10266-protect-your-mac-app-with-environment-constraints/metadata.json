      "title": "Example constraint",
      "language": "xml",
      "startTimeSeconds": 575,
      "code": "// Example constraint\n\n<dict>\n    <key>$or-array</key>\n    <array>\n        <array>\n            <string>$and</string>\n            <dict>\n                <key>team-identifier</key>\n                <string>M2657GZ2M9</string>\n            </dict>\n        </array>\n        <array>\n            <string>$and</string>\n            <dict>\n                <key>signing-identifier</key>\n                <string>com.smith.libraryB</string>\n                <key>team-identifier</key>\n                <string>P9Z4AN7VHQ</string>\n            </dict>\n        </array>\n        <array>\n            <string>$and</string>\n            <dict>\n                <key>signing-identifier</key>\n                <string>com.friday.libraryC</string>\n                <key>team-identifier</key>\n                <string>TA1570ZFMZ</string>\n            </dict>\n        </array>\n    </array>\n</dict>"
    },
    {
      "title": "Example parent launch constraint",
      "language": "xml",
      "startTimeSeconds": 662,
      "code": "<dict>\n    <key>team-identifier</key>\n    <string>M2657GZ2M9</string>\n    <key>signing-identifier</key>\n    <string>com.demo.MyDemo</string>\n</dict>"
    },
    {
      "title": "Example process launch constraint",
      "language": "xml",
      "startTimeSeconds": 846,
      "code": "<dict>\n    <key>team-identifier</key>\n    <string>M2657GZ2M9</string>\n    <key>signing-identifier</key>\n    <dict>\n        <key>$in</key>\n        <array>\n            <string>com.demo.MyDemo</string>\n            <string>com.demo.DemoMenuBar</string>\n            <string>demohelper</string>\n        </array>\n    </dict>\n</dict>"
    },
    {
      "title": "Example launchd plist constraint",
      "language": "xml",
      "startTimeSeconds": 892,
      "code": "// Example launchd plist constraint\n\n<dict>\n    <key>Label</key>\n    <string>com.demo.DemoMenuBar.agent</string>\n    <key>BundleProgram</key>\n    <string>Contents/Library/LaunchAgents/DemoMenuBar.app/Contents/MacOS/DemoMenuBar</string>\n    <key>KeepAlive</key>\n    <dict>\n        <key>SuccessfulExit</key>\n        <true/>\n    </dict>\n    <key>RunAtLoad</key>\n    <true/>\n    <key>SpawnConstraint</key>\n    <dict>\n        <key>team-identifier</key>\n        <string>M2657GZ2M9</string>\n        <key>signing-identifier</key>\n        <string>com.demo.DemoMenuBar</string>\n    </dict>\n</dict>"
    },
