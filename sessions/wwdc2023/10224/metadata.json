  "codeSnippets": [
    {
      "title": "Use Xcode Cloud to add a Git commit message to TestFlight What to Test",
      "language": "bash",
      "startTimeSeconds": 530,
      "code": "#!/bin/zsh\n#  ci_post_xcodebuild.sh\n\nif [[ -d \"$CI_APP_STORE_SIGNED_APP_PATH\" ]]; then\n  TESTFLIGHT_DIR_PATH=../TestFlight\n  mkdir $TESTFLIGHT_DIR_PATH\n  git log -1 --pretty=format:\"%s\" >! $TESTFLIGHT_DIR_PATH/WhatToTest.en-US.txt\nfi"
    }
  ],
