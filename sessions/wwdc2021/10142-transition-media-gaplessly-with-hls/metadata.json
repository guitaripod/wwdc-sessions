      "title": "create two items, enqueue in order and play gaplessly",
      "language": "swift",
      "startTimeSeconds": 372,
      "code": "// create two items, enqueue in order, \n// and play gaplessly\n\nlet item1 = AVPlayerItem(url: url1)\nlet item2 = AVPlayerItem(url: url2)\n\nlet player = AVQueuePlayer()\n\nplayer.insert(item1, after: nil)\nplayer.insert(item2, after: item1)\n\nplayer.play()"
    }
