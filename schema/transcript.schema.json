{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guitaripod/wwdc-sessions/master/schema/transcript.schema.json",
  "title": "WWDC Session Transcript",
  "description": "Machine transcript for one session: sessions/<event>/<n>-<slug>/transcript.json.",
  "type": "object",
  "required": ["id", "language", "source", "wordCount", "segments"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "examples": ["wwdc2026-298"] },
    "language": { "type": "string", "examples": ["eng"] },
    "source": { "type": "string", "format": "uri", "description": "Canonical Apple session URL (cite this)." },
    "wordCount": { "type": "integer" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "text"],
        "properties": {
          "start": { "type": "number", "description": "Seconds from the start of the talk." },
          "text": { "type": "string" }
        }
      }
    }
  }
}
